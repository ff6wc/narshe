# Discord OAuth2 and JWT Configuration Template
# Copy this file to '.env' and fill in your actual credentials for local development.

# The Client ID from your Discord Developer Portal
DISCORD_CLIENT_ID=your_discord_client_id_here

# The Client Secret from your Discord Developer Portal (Keep this secure!)
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# The callback URL (e.g. http://localhost:5000/api/v1/auth/callback for local, or your production API URL)
DISCORD_REDIRECT_URI=http://localhost:5000/api/v1/auth/callback

# The URL of your static frontend (e.g. http://localhost:3000 for development, or your production site)
ULTIMA_FRONTEND_URL=http://localhost:3000

# A long, random string used to securely sign session tokens (JWT)
JWT_SECRET_KEY=your_super_secret_jwt_key_here
